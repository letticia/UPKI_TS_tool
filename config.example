# amano-ts.sh 設定ファイルのひな形
#
# このファイルを ~/.amano-ts/config にコピーし、契約時に通知された
# 「タイムスタンプ利用情報」の URL を記入してください。
#
#   mkdir -p ~/.amano-ts
#   cp config.example ~/.amano-ts/config
#   chmod 600 ~/.amano-ts/config
#
# ※ TSA の URL は契約者向けの情報です。公開リポジトリにコミットしないでください。

# TSA エンドポイント URL(stamp に必須)
TSA_URL=""

# 期待する TSTInfo ポリシー OID(省略時は Type-T2 の 0.2.440.200192.100.200.103)
# 照合しない場合は any
#EXPECT_POLICY="0.2.440.200192.100.200.103"
